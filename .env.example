# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Cloud key with Places API (New) + Geocoding API enabled.
# This now lives ONLY here — the mobile app never sees it.
GOOGLE_API_KEY=your_google_api_key_here

# TheSportsDB — the free tier's public test key ("123") works fine here too;
# only worth changing if you've bought a Patreon/Premium key.
SPORTSDB_KEY=123

# A secret only your app knows, sent as a header on every request. This is
# NOT a substitute for the Google key being private — it's a separate,
# cheaper-to-rotate gate that stops randoms from hitting your backend
# directly and running up YOUR Google bill even without your Google key.
# Generate one with: openssl rand -hex 32
APP_SHARED_SECRET=change_this_to_a_long_random_string

PORT=3000
